APP_ENV=development
APP_MODE=mock

HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./jingxue.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEFAULT_LLM_PROVIDER=qwen
BACKUP_LLM_PROVIDER=mock

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v4-pro

MASTER_AGENT_PROVIDER=deepseek
MASTER_AGENT_MODEL=deepseek-v4-pro

PROFILE_AGENT_PROVIDER=qwen
PROFILE_AGENT_MODEL=qwen3.7-max

IDEA_AGENT_PROVIDER=deepseek
IDEA_AGENT_MODEL=deepseek-v4-pro

PROPOSAL_AGENT_PROVIDER=qwen
PROPOSAL_AGENT_MODEL=qwen3.7-plus

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
REQUEST_BODY_LIMIT_BYTES=1048576
